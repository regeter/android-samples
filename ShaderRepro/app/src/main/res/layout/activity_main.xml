<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:fitsSystemWindows="true"
    android:background="#121212">

    <!-- Top Alert Banner: Turns Red on 1st Hit (Reset Caught) & Gold/Black on Fatal Crash -->
    <TextView
        android:id="@+id/tvAlertBanner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#2E7D32"
        android:padding="10dp"
        android:text="STATUS: READY | 10s GmmRenderTarget Trap Armed"
        android:textColor="#FFFFFF"
        android:textSize="13sp"
        android:textStyle="bold"
        android:gravity="center" />

    <!-- Telemetry HUD Card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#1E1E1E"
        android:padding="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvLoopCount"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="#E0E0E0"
                android:textSize="12sp"
                android:text="Loops: 0" />

            <TextView
                android:id="@+id/tvMapViewAge"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="#E0E0E0"
                android:textSize="12sp"
                android:text="MapView Age: 0.0s" />

            <TextView
                android:id="@+id/tvProgramsLinked"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="#E0E0E0"
                android:textSize="12sp"
                android:text="Shaders: 0" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvShaderCache"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="#90CAF9"
            android:textSize="11sp"
            android:text="Shader Disk Cache: 0 B (0 files)" />
    </LinearLayout>

    <!-- Contention Mode Selector -->
    <RadioGroup
        android:id="@+id/rgMode"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="#262626"
        android:paddingHorizontal="4dp"
        android:paddingVertical="2dp">

        <RadioButton
            android:id="@+id/rbModeA"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="A: Ads+WebGL"
            android:textColor="#E0E0E0"
            android:textSize="11sp" />

        <RadioButton
            android:id="@+id/rbModeB"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="B: Synth Stress"
            android:textColor="#E0E0E0"
            android:textSize="11sp" />

        <RadioButton
            android:id="@+id/rbModeC"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="C: Combined"
            android:checked="true"
            android:textColor="#E0E0E0"
            android:textSize="11sp" />
    </RadioGroup>

    <!-- Control Buttons Panel -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="4dp"
        android:background="#1E1E1E">

        <Button
            android:id="@+id/btnStartStop"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1.2"
            android:layout_marginEnd="2dp"
            android:text="Start Repro Loop"
            android:textSize="11sp"
            android:textAllCaps="false"
            android:padding="0dp"
            android:backgroundTint="#1976D2"
            android:textColor="#FFFFFF" />

        <Button
            android:id="@+id/btnTrimMemory"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:layout_marginHorizontal="2dp"
            android:text="Trim Memory"
            android:textSize="11sp"
            android:textAllCaps="false"
            android:padding="0dp"
            android:backgroundTint="#F57C00"
            android:textColor="#FFFFFF" />

        <Button
            android:id="@+id/btnClearCache"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:layout_marginStart="2dp"
            android:text="Clear Cache"
            android:textSize="11sp"
            android:textAllCaps="false"
            android:padding="0dp"
            android:backgroundTint="#7B1FA2"
            android:textColor="#FFFFFF" />
    </LinearLayout>

    <!-- Map View Container (cycles MapView instances while trap not locked) -->
    <FrameLayout
        android:id="@+id/mapContainer"
        android:layout_width="match_parent"
        android:layout_height="220dp"
        android:background="#000000" />

    <!-- Mode A Ads & WebGL Contention Section -->
    <LinearLayout
        android:id="@+id/adsAndWebContainer"
        android:layout_width="match_parent"
        android:layout_height="140dp"
        android:orientation="vertical"
        android:background="#1A1A1A">

        <!-- Two banner ad slots for play-services-ads -->
        <FrameLayout
            android:id="@+id/adSlot1"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_gravity="center" />

        <FrameLayout
            android:id="@+id/adSlot2"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_gravity="center" />

        <!-- Hardware-accelerated WebGL shader churn canvas -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="40dp">

            <WebView
                android:id="@+id/webViewWebGL"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
        </FrameLayout>
    </LinearLayout>

    <!-- Scrolling Console Log View -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:background="#0A0A0A">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="#151515"
            android:paddingHorizontal="8dp"
            android:paddingVertical="2dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Console &amp; Logcat Stream"
                android:textColor="#888888"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/btnClearLog"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Clear"
                android:textColor="#64B5F6"
                android:textSize="10sp"
                android:padding="4dp" />
        </LinearLayout>

        <ScrollView
            android:id="@+id/logScrollView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:padding="6dp">

            <TextView
                android:id="@+id/tvConsoleLog"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:textColor="#E0E0E0"
                android:textSize="10sp"
                android:textIsSelectable="true"
                tools:text="[Ready] Select mode and press 'Start Repro Loop'..." />
        </ScrollView>
    </LinearLayout>

</LinearLayout>
